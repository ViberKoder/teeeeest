;; =================================================================
;; EGG jetton-wallet
;;
;; A TEP-74 jetton-wallet with one addition: it can credit itself with
;; tokens the project owes the owner ("cumulative claim"). The claim is
;; either attached to a normal `transfer` (custom_payload) or sent on its
;; own (`op::claim`). Both go through the same `verify_claim`.
;;
;;   claim$_ cumulative:Coins valid_until:uint48
;;           signer:uint256 key_id:uint32 cert_until:uint48
;;           claim_sig:^bits512 cert_sig:^bits512
;;
;; Storage:
;;   balance, owner, master, ^wallet_code,
;;   ^{ authority:uint256 claimed:Coins key_floor:uint32 }
;; `authority` is part of the address (it is part of the initial data), so
;; hot signer keys can rotate freely without moving anybody's wallet.
;; =================================================================

#include "imports/stdlib.fc";
#include "imports/egg-common.fc";

(int, slice, slice, cell, int, int, int) load_data() inline {
  slice ds = get_data().begin_parse();
  int balance = ds~load_coins();
  slice owner = ds~load_msg_addr();
  slice master = ds~load_msg_addr();
  cell code = ds~load_ref();
  slice cold = ds~load_ref().begin_parse();
  int authority = cold~load_uint(256);
  int claimed = cold~load_coins();
  int key_floor = cold~load_uint(32);
  return (balance, owner, master, code, authority, claimed, key_floor);
}

() save_data(int balance, slice owner, slice master, cell code,
             int authority, int claimed, int key_floor) impure inline {
  set_data(pack_wallet_data(balance, owner, master, code, authority, claimed, key_floor));
}

;; Verifies a claim and returns (new_claimed, new_key_floor, delta).
(int, int, int) verify_claim(slice cp, slice owner, slice master,
                             int authority, int claimed, int key_floor) impure inline_ref {
  int cumulative = cp~load_coins();
  int valid_until = cp~load_uint(48);
  int signer = cp~load_uint(256);
  int key_id = cp~load_uint(32);
  int cert_until = cp~load_uint(48);
  slice claim_sig = cp~load_ref().begin_parse();
  slice cert_sig = cp~load_ref().begin_parse();
  cp.end_parse();

  int t = now();
  throw_unless(err::claim_expired, t <= valid_until);
  throw_unless(err::cert_expired, t <= cert_until);
  throw_unless(err::key_revoked, key_id >= key_floor);
  throw_unless(err::bad_cert_sig,
    check_signature(cert_hash(master, signer, key_id, cert_until), cert_sig, authority));
  throw_unless(err::bad_claim_sig,
    check_signature(claim_hash(master, owner, cumulative, valid_until), claim_sig, signer));
  throw_unless(err::claim_regress, cumulative >= claimed);
  return (cumulative, key_id, cumulative - claimed);
}

() notify_master(slice master, slice owner, int delta, int query_id) impure inline {
  cell body = begin_cell()
    .store_uint(op::claimed, 32)
    .store_uint(query_id, 64)
    .store_coins(delta)
    .store_slice(owner)
    .end_cell();
  send_raw_message(msg_with_body(master, claim_notify_value, body, false), 0);
}

() send_tokens(slice in_msg_body, slice sender, int msg_value, int fwd_fee, int my_balance) impure {
  int query_id = in_msg_body~load_uint(64);
  int jetton_amount = in_msg_body~load_coins();
  slice to_owner = in_msg_body~load_msg_addr();
  slice response = in_msg_body~load_msg_addr();
  cell custom_payload = in_msg_body~load_maybe_ref();
  int fwd_ton = in_msg_body~load_coins();
  slice either_payload = in_msg_body;
  throw_unless(708, either_payload.slice_bits() >= 1);

  (int balance, slice owner, slice master, cell code,
   int authority, int claimed, int key_floor) = load_data();
  throw_unless(err::not_owner, equal_slices(sender, owner));
  (int wc, _) = parse_std_addr(to_owner);
  throw_unless(err::wrong_workchain, wc == workchain());

  int delta = 0;
  int has_claim = ~ custom_payload.null?();
  if (has_claim) {
    (claimed, key_floor, delta) = verify_claim(
      custom_payload.begin_parse(), owner, master, authority, claimed, key_floor);
    balance += delta;
  }
  throw_unless(err::not_enough_jetton, balance >= jetton_amount);
  balance -= jetton_amount;

  int fwd_count = fwd_ton ? 2 : 1;
  int need = fwd_ton + fwd_count * fwd_fee + (2 * gas_consumption + min_tons_for_storage);
  if (has_claim) {
    need += claim_gas_extra;
    if (delta > 0) {
      need += claim_notify_value + fwd_fee;
    }
  }
  throw_unless(err::not_enough_ton, msg_value >= need);

  save_data(balance, owner, master, code, authority, claimed, key_floor);

  cell state_init = wallet_state_init(to_owner, master, code, authority);
  slice to_wallet = address_of_state_init(state_init);
  cell body = begin_cell()
    .store_uint(op::internal_transfer, 32)
    .store_uint(query_id, 64)
    .store_coins(jetton_amount)
    .store_slice(owner)
    .store_slice(response)
    .store_coins(fwd_ton)
    .store_slice(either_payload)
    .end_cell();

  ;; Everything the user attached is spent on this operation; the wallet's own
  ;; TON balance is never touched.
  raw_reserve(max(my_balance - msg_value, min_tons_for_storage), 0);
  if (delta > 0) {
    notify_master(master, owner, delta, query_id);
  }
  send_raw_message(msg_with_init(to_wallet, 0, body, state_init), 128);
}

() claim_only(slice in_msg_body, slice sender, int msg_value, int fwd_fee, int my_balance) impure {
  int query_id = in_msg_body~load_uint(64);
  (int balance, slice owner, slice master, cell code,
   int authority, int claimed, int key_floor) = load_data();
  throw_unless(err::not_owner, equal_slices(sender, owner));

  (claimed, key_floor, int delta) = verify_claim(in_msg_body, owner, master, authority, claimed, key_floor);
  throw_unless(err::not_enough_ton,
    msg_value >= claim_notify_value + 2 * fwd_fee + gas_consumption + claim_gas_extra + min_tons_for_storage);

  save_data(balance + delta, owner, master, code, authority, claimed, key_floor);

  raw_reserve(max(my_balance - msg_value, min_tons_for_storage), 0);
  if (delta > 0) {
    notify_master(master, owner, delta, query_id);
  }
  cell body = begin_cell().store_uint(op::excesses, 32).store_uint(query_id, 64).end_cell();
  send_raw_message(msg_with_body(owner, 0, body, false), 128);
}

() receive_tokens(slice in_msg_body, slice sender, int my_balance, int fwd_fee, int msg_value) impure {
  (int balance, slice owner, slice master, cell code,
   int authority, int claimed, int key_floor) = load_data();
  int query_id = in_msg_body~load_uint(64);
  int amount = in_msg_body~load_coins();
  slice from = in_msg_body~load_msg_addr();
  slice response = in_msg_body~load_msg_addr();
  int fwd_ton = in_msg_body~load_coins();
  slice either_payload = in_msg_body;

  ;; Only the master (mint) or a genuine wallet of this jetton may credit us.
  throw_unless(err::not_valid_wallet,
    equal_slices(master, sender)
    | equal_slices(wallet_address(from, master, code, authority), sender));

  save_data(balance + amount, owner, master, code, authority, claimed, key_floor);

  int ton_before = my_balance - msg_value;
  int storage_fee = min_tons_for_storage - min(ton_before, min_tons_for_storage);
  msg_value -= (storage_fee + gas_consumption);

  if (fwd_ton > 0) {
    msg_value -= (fwd_ton + fwd_fee);
    cell note = begin_cell()
      .store_uint(op::transfer_notification, 32)
      .store_uint(query_id, 64)
      .store_coins(amount)
      .store_slice(from)
      .store_slice(either_payload)
      .end_cell();
    send_raw_message(msg_with_body(owner, fwd_ton, note, false), 1);
  }

  if ((response.preload_uint(2) != 0) & (msg_value > 0)) {
    cell body = begin_cell().store_uint(op::excesses, 32).store_uint(query_id, 64).end_cell();
    send_raw_message(msg_with_body(response, msg_value, body, false), 2);
  }
}

() burn_tokens(slice in_msg_body, slice sender, int msg_value, int fwd_fee) impure {
  int query_id = in_msg_body~load_uint(64);
  int amount = in_msg_body~load_coins();
  slice response = in_msg_body~load_msg_addr();
  (int balance, slice owner, slice master, cell code,
   int authority, int claimed, int key_floor) = load_data();
  throw_unless(err::not_owner, equal_slices(sender, owner));
  throw_unless(err::not_enough_jetton, balance >= amount);
  throw_unless(err::not_enough_ton, msg_value >= fwd_fee + 2 * gas_consumption);
  save_data(balance - amount, owner, master, code, authority, claimed, key_floor);
  cell body = begin_cell()
    .store_uint(op::burn_notification, 32)
    .store_uint(query_id, 64)
    .store_coins(amount)
    .store_slice(owner)
    .store_slice(response)
    .end_cell();
  send_raw_message(msg_with_body(master, 0, body, true), 64);
}

;; A bounced transfer/burn means tokens never left: give them back.
() on_bounce(slice in_msg_body) impure {
  in_msg_body~skip_bits(32);
  if (in_msg_body.slice_bits() < 32 + 64 + 4) {
    return ();
  }
  int op = in_msg_body~load_uint(32);
  in_msg_body~skip_bits(64);
  if ((op == op::internal_transfer) | (op == op::burn_notification)) {
    int amount = in_msg_body~load_coins();
    (int balance, slice owner, slice master, cell code,
     int authority, int claimed, int key_floor) = load_data();
    save_data(balance + amount, owner, master, code, authority, claimed, key_floor);
  }
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
  slice cs = in_msg_full.begin_parse();
  int flags = cs~load_uint(4);
  if (flags & 1) {
    on_bounce(in_msg_body);
    return ();
  }
  if (in_msg_body.slice_empty?()) {
    return ();
  }
  slice sender = cs~load_msg_addr();
  cs~load_msg_addr();
  cs~load_coins();
  cs~skip_bits(1);
  cs~load_coins();
  int fwd_fee = muldiv(cs~load_coins(), 3, 2);

  int op = in_msg_body~load_uint(32);
  if (op == op::transfer) {
    send_tokens(in_msg_body, sender, msg_value, fwd_fee, my_balance);
    return ();
  }
  if (op == op::internal_transfer) {
    receive_tokens(in_msg_body, sender, my_balance, fwd_fee, msg_value);
    return ();
  }
  if (op == op::claim) {
    claim_only(in_msg_body, sender, msg_value, fwd_fee, my_balance);
    return ();
  }
  if (op == op::burn) {
    burn_tokens(in_msg_body, sender, msg_value, fwd_fee);
    return ();
  }
  throw(err::unknown_op);
}

;; ---- get methods ----
(int, slice, slice, cell) get_wallet_data() method_id {
  (int balance, slice owner, slice master, cell code, _, _, _) = load_data();
  return (balance, owner, master, code);
}

;; (claimed so far, lowest accepted signer key id, authority pubkey)
(int, int, int) get_claim_state() method_id {
  (_, _, _, _, int authority, int claimed, int key_floor) = load_data();
  return (claimed, key_floor, authority);
}
