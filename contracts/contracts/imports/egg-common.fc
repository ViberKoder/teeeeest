;; =================================================================
;; EGG jetton — shared constants and helpers
;;
;; Trust model (one paragraph, because everything below follows from it):
;;   * `authority` is a COLD ed25519 public key fixed at deploy time.
;;   * It certifies short-lived HOT signer keys (`cert`).
;;   * A hot signer signs per-user cumulative claims (`claim`).
;;   * A jetton-wallet accepts a claim only with a valid cert + claim pair.
;; Wallets never need to ask the master anything, so a claim is verified
;; and applied inside the same transaction as the user's own transfer.
;; =================================================================

;; ---- TEP-74 / TEP-89 ----
const int op::transfer = 0x0f8a7ea5;
const int op::transfer_notification = 0x7362d09c;
const int op::internal_transfer = 0x178d4519;
const int op::excesses = 0xd53276db;
const int op::burn = 0x595f07bc;
const int op::burn_notification = 0x7bdd97de;
const int op::provide_wallet_address = 0x2c76b973;
const int op::take_wallet_address = 0xd1735400;

;; ---- EGG specific ----
const int op::mint = 21;
const int op::change_admin = 3;
const int op::change_content = 4;
;; owner -> own jetton-wallet: apply a claim without moving tokens
const int op::claim = 0x2f8a1d44;
;; jetton-wallet -> master: bookkeeping so total_supply stays truthful
const int op::claimed = 0x6c0a5b21;

;; Domain separation tags ("EGGC", "EGGL"): a signature made for one purpose
;; can never be replayed for another.
const int domain::cert = 0x45474743;
const int domain::claim = 0x4547474c;

;; ---- Errors ----
const int err::unauthorized = 73;
const int err::unknown_op = 0xffff;
const int err::wrong_workchain = 333;
const int err::not_owner = 705;
const int err::not_enough_ton = 706;
const int err::not_enough_jetton = 707;
const int err::not_valid_wallet = 708;
const int err::wrong_op = 709;
const int err::claim_expired = 810;
const int err::cert_expired = 811;
const int err::key_revoked = 812;
const int err::bad_cert_sig = 813;
const int err::bad_claim_sig = 814;
const int err::claim_regress = 815;
const int err::max_supply_exceeded = 816;

;; ---- Economics of gas (nanoTON) ----
const int gas_consumption = 15000000;      ;; 0.015
const int min_tons_for_storage = 10000000; ;; 0.01
const int claim_notify_value = 10000000;   ;; 0.01 forwarded to master
const int claim_gas_extra = 20000000;      ;; 0.02 extra compute for 2x CHKSIGNU

;; ---- low level ----
int equal_slices(slice a, slice b) asm "SDEQ";
int check_signature(int hash, slice signature, int public_key) asm "CHKSIGNU";

int workchain() inline { return 0; }

;; ---- addresses ----
cell pack_wallet_data(int balance, slice owner, slice master, cell wallet_code,
                      int authority, int claimed, int key_floor) inline {
  cell cold = begin_cell()
    .store_uint(authority, 256)
    .store_coins(claimed)
    .store_uint(key_floor, 32)
    .end_cell();
  return begin_cell()
    .store_coins(balance)
    .store_slice(owner)
    .store_slice(master)
    .store_ref(wallet_code)
    .store_ref(cold)
    .end_cell();
}

cell wallet_state_init(slice owner, slice master, cell wallet_code, int authority) inline {
  cell data = pack_wallet_data(0, owner, master, wallet_code, authority, 0, 0);
  return begin_cell()
    .store_uint(0, 2)
    .store_maybe_ref(wallet_code)
    .store_maybe_ref(data)
    .store_uint(0, 1)
    .end_cell();
}

slice address_of_state_init(cell state_init) inline {
  return begin_cell()
    .store_uint(4, 3)
    .store_int(workchain(), 8)
    .store_uint(cell_hash(state_init), 256)
    .end_cell()
    .begin_parse();
}

slice wallet_address(slice owner, slice master, cell wallet_code, int authority) inline {
  return address_of_state_init(wallet_state_init(owner, master, wallet_code, authority));
}

;; ---- messages ----
cell msg_with_init(slice to, int value, cell body, cell state_init) inline {
  return begin_cell()
    .store_uint(0x18, 6)
    .store_slice(to)
    .store_coins(value)
    .store_uint(4 + 2 + 1, 1 + 4 + 4 + 64 + 32 + 1 + 1 + 1)
    .store_ref(state_init)
    .store_ref(body)
    .end_cell();
}

cell msg_with_body(slice to, int value, cell body, int bounce) inline {
  return begin_cell()
    .store_uint(bounce ? 0x18 : 0x10, 6)
    .store_slice(to)
    .store_coins(value)
    .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
    .store_ref(body)
    .end_cell();
}

;; ---- signed material ----
int cert_hash(slice master, int signer, int key_id, int cert_until) inline {
  return cell_hash(begin_cell()
    .store_uint(domain::cert, 32)
    .store_slice(master)
    .store_uint(signer, 256)
    .store_uint(key_id, 32)
    .store_uint(cert_until, 48)
    .end_cell());
}

int claim_hash(slice master, slice owner, int cumulative, int valid_until) inline {
  return cell_hash(begin_cell()
    .store_uint(domain::claim, 32)
    .store_slice(master)
    .store_slice(owner)
    .store_coins(cumulative)
    .store_uint(valid_until, 48)
    .end_cell());
}
