;; =================================================================
;; EGG jetton-master
;;
;; TEP-74 minter plus:
;;   * `authority` — cold ed25519 key that certifies hot claim signers
;;     (fixed for the life of the token, it is part of every wallet address)
;;   * op::claimed — bookkeeping from wallets so total_supply is truthful
;;
;; The master holds no Merkle root, no epoch, no pause flag: wallets verify
;; claims on their own, so there is nothing on the master that could drift
;; out of sync with them.
;; =================================================================

#include "imports/stdlib.fc";
#include "imports/egg-common.fc";

;; total_supply, max_supply, admin, content, wallet_code, authority
(int, int, slice, cell, cell, int) load_data() inline {
  slice ds = get_data().begin_parse();
  int total_supply = ds~load_coins();
  int max_supply = ds~load_coins();
  slice admin = ds~load_msg_addr();
  cell content = ds~load_ref();
  cell code = ds~load_ref();
  int authority = ds~load_uint(256);
  return (total_supply, max_supply, admin, content, code, authority);
}

() save_data(int total_supply, int max_supply, slice admin, cell content,
             cell code, int authority) impure inline {
  set_data(begin_cell()
    .store_coins(total_supply)
    .store_coins(max_supply)
    .store_slice(admin)
    .store_ref(content)
    .store_ref(code)
    .store_uint(authority, 256)
    .end_cell());
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
  if (in_msg_body.slice_empty?()) {
    return ();
  }
  slice cs = in_msg_full.begin_parse();
  int flags = cs~load_uint(4);
  if (flags & 1) {
    return ();
  }
  slice sender = cs~load_msg_addr();
  cs~load_msg_addr();
  cs~load_coins();
  cs~skip_bits(1);
  cs~load_coins();
  int fwd_fee = muldiv(cs~load_coins(), 3, 2);

  int op = in_msg_body~load_uint(32);
  int query_id = in_msg_body~load_uint(64);
  (int total_supply, int max_supply, slice admin, cell content, cell code, int authority) = load_data();

  if (op == op::mint) {
    throw_unless(err::unauthorized, equal_slices(sender, admin));
    slice to = in_msg_body~load_msg_addr();
    int ton_amount = in_msg_body~load_coins();
    cell master_msg = in_msg_body~load_ref();
    slice mm = master_msg.begin_parse();
    throw_unless(err::wrong_op, mm~load_uint(32) == op::internal_transfer);
    mm~skip_bits(64);
    int amount = mm~load_coins();
    if (max_supply > 0) {
      throw_if(err::max_supply_exceeded, total_supply + amount > max_supply);
    }
    cell init = wallet_state_init(to, my_address(), code, authority);
    send_raw_message(msg_with_init(address_of_state_init(init), ton_amount, master_msg, init), 1);
    save_data(total_supply + amount, max_supply, admin, content, code, authority);
    return ();
  }

  if (op == op::claimed) {
    int delta = in_msg_body~load_coins();
    slice owner = in_msg_body~load_msg_addr();
    throw_unless(err::not_valid_wallet,
      equal_slices(wallet_address(owner, my_address(), code, authority), sender));
    save_data(total_supply + delta, max_supply, admin, content, code, authority);
    return ();
  }

  if (op == op::burn_notification) {
    int amount = in_msg_body~load_coins();
    slice from = in_msg_body~load_msg_addr();
    slice response = in_msg_body~load_msg_addr();
    throw_unless(err::not_valid_wallet,
      equal_slices(wallet_address(from, my_address(), code, authority), sender));
    save_data(total_supply - amount, max_supply, admin, content, code, authority);
    if (response.preload_uint(2) != 0) {
      cell body = begin_cell().store_uint(op::excesses, 32).store_uint(query_id, 64).end_cell();
      send_raw_message(msg_with_body(response, 0, body, false), 2 + 64);
    }
    return ();
  }

  if (op == op::provide_wallet_address) {
    throw_unless(err::not_enough_ton, msg_value > fwd_fee + 10000000);
    slice owner = in_msg_body~load_msg_addr();
    int include_owner = in_msg_body~load_uint(1);
    cell included = include_owner ? begin_cell().store_slice(owner).end_cell() : null();
    cell body = begin_cell()
      .store_uint(op::take_wallet_address, 32)
      .store_uint(query_id, 64)
      .store_slice(wallet_address(owner, my_address(), code, authority))
      .store_maybe_ref(included)
      .end_cell();
    send_raw_message(msg_with_body(sender, 0, body, false), 64);
    return ();
  }

  if (op == op::change_admin) {
    throw_unless(err::unauthorized, equal_slices(sender, admin));
    slice new_admin = in_msg_body~load_msg_addr();
    save_data(total_supply, max_supply, new_admin, content, code, authority);
    return ();
  }

  if (op == op::change_content) {
    throw_unless(err::unauthorized, equal_slices(sender, admin));
    save_data(total_supply, max_supply, admin, in_msg_body~load_ref(), code, authority);
    return ();
  }

  throw(err::unknown_op);
}

;; ---- get methods ----
(int, int, slice, cell, cell) get_jetton_data() method_id {
  (int total_supply, int max_supply, slice admin, cell content, cell code, _) = load_data();
  return (total_supply, -1, admin, content, code);
}

slice get_wallet_address(slice owner) method_id {
  (_, _, _, _, cell code, int authority) = load_data();
  return wallet_address(owner, my_address(), code, authority);
}

int get_max_supply() method_id {
  (_, int max_supply, _, _, _, _) = load_data();
  return max_supply;
}

int get_authority() method_id {
  (_, _, _, _, _, int authority) = load_data();
  return authority;
}
