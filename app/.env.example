# Public base URL of the claim server
VITE_API_URL=https://api.example.org
VITE_NETWORK=mainnet
# EGG jetton master (user-friendly or raw)
VITE_JETTON_MASTER=
# Optional: toncenter API key (raises the rate limit), tonapi key for history
VITE_TONCENTER_KEY=
VITE_TONAPI_KEY=
# Public origin of the deployed Mini App (used for the TON Connect manifest)
VITE_PUBLIC_URL=https://app12345.tgcloud.ai
# Set to 1 for a self-contained demo with fixtures (no chain, no server)
VITE_DEMO=
