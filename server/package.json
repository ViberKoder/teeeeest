{
  "name": "@egg/server",
  "version": "0.2.0",
  "private": true,
  "description": "Operator tools for EGG: wallet generation, minter deployment, and the tests that pin the Serverless (pure-JS) library to the SDK and the contracts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen-wallet": "tsx scripts/gen-wallet.ts",
    "deploy-minter": "tsx scripts/deploy-minter.ts"
  },
  "dependencies": {
    "@ton/core": "^0.62.0",
    "tsx": "^4.19.2",
    "@egg/sdk": "*",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^15.4.0"
  },
  "devDependencies": {
    "@ton/sandbox": "^0.45.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.5",
    "vitest": "^2.0.5",
    "@ton/test-utils": "^0.4.2"
  }
}
