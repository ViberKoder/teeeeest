PORT=3000
DB_PATH=./egg.db
CORS_ORIGINS=*

BOT_TOKEN=123456:replace-me
INGEST_API_KEY=replace-with-at-least-24-random-characters

NETWORK=testnet
TONCENTER_KEY=
JETTON_MASTER_ADDRESS=
# hot wallet that publishes roots (npm run gen-wallet). The contract rate-limits it.
PUBLISHER_MNEMONIC=
PUBLISH_INTERVAL_SECONDS=600

# optional: hot wallet that pays for new players' first hatches (gasless relay). Fund it with TON.
RELAYER_MNEMONIC=
RELAY_VALUE=150000000
RELAY_MAX_PER_USER=3

# jetton units (decimals 9 => 1 EGG = 1000000000). Must equal the on-chain max supply.
MAX_SUPPLY_UNITS=100000000000000000000
MAX_EVENT_UNITS=1000000000000

JETTON_NAME=Egg
JETTON_SYMBOL=EGG
JETTON_DECIMALS=9
JETTON_DESCRIPTION=Hatch eggs. Earn EGG.
JETTON_IMAGE_URL=
