PORT=3000
DB_PATH=./egg.db
CORS_ORIGINS=*

BOT_TOKEN=123456:replace-me
INGEST_API_KEY=replace-with-at-least-24-random-characters

# npm run keys  (authority secret stays OFFLINE)
SIGNER_SEED_HEX=
AUTHORITY_PUBKEY_HEX=
# npm run cert  (run where the authority secret lives)
KEY_CERT_B64=
JETTON_MASTER_ADDRESS=

CLAIM_TTL_SECONDS=600
# jetton units (decimals 9 => 1 EGG = 1000000000). 0 disables the cap.
MAX_SUPPLY_UNITS=0
MAX_EVENT_UNITS=1000000000000

JETTON_NAME=Egg
JETTON_SYMBOL=EGG
JETTON_DECIMALS=9
JETTON_DESCRIPTION=Hatch eggs. Earn EGG.
JETTON_IMAGE_URL=
