{
  "name": "egg",
  "version": "0.2.0",
  "private": true,
  "description": "EGG — a self-custody TON wallet Mini App and the jetton behind it",
  "license": "MIT",
  "workspaces": ["contracts", "server", "app"],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "contracts:build": "npm run build -w @egg/contracts",
    "server:dev": "npm run dev -w @egg/server",
    "app:dev": "npm run dev -w @egg/app"
  }
}
